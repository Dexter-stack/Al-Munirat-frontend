# Base URL of the Laravel API, including version prefix.
# Never hard-code this elsewhere in the app — always read it via import.meta.env.VITE_API_BASE_URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# While the backend isn't reachable, run against the typed mock layer
# (src/api/mocks/) instead of the network — see API_CONTRACT.md §15.
# Demo accounts once this is "true": see README.md "Mock mode" section.
# Flip to "false" the moment the real backend above is up.
VITE_USE_MOCKS=true
