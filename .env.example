# Base URL of the Laravel API, including version prefix.
# Never hard-code this elsewhere in the app — always read it via import.meta.env.VITE_API_BASE_URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set to "true" to run against the built-in typed mock layer instead of a
# real backend (see API_CONTRACT.md §15 and src/api/mocks/). Leave unset
# or "false" for staging/production.
VITE_USE_MOCKS=false
